rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Students can add themselves to the roster (no login needed), but
    // only the signed-in owner can view, edit, or remove any islander —
    // this is what stops anyone from reading the roster or messing with
    // other people's entries.
    match /islanders/{islanderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Locked-in couples, generated match results, and reveal position —
    // owner-only end to end, students never touch this.
    match /app_state/{stateId} {
      allow read, write: if request.auth != null;
    }
  }
}
